# SQL Server connection (Windows Auth + TrustServerCertificate, matching the API/worker).
SQL_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=MarketEdge;Trusted_Connection=yes;TrustServerCertificate=yes;

# yfinance throttle settings (carried over from the worker).
YFINANCE_BATCH_SIZE=50
YFINANCE_BATCH_DELAY=2.0
YFINANCE_MAX_RETRIES=4

# Exponential-backoff base delay (s) for per-ticker fundamentals calls that hit a Yahoo
# rate limit ("Too Many Requests") or "Invalid Crumb"; attempt N waits ~base*2**N + jitter.
YFINANCE_RETRY_BASE_DELAY=1.5

# Parallel threads inside a single yfinance batch download / market-cap chunk.
YFINANCE_THREADS=10

# Worker threads for the per-symbol fundamentals loop. Keep low (4) to stay under Yahoo's
# per-IP rate limit; set 1 for fully sequential. Optional extra pacing between tickers:
FUNDAMENTALS_THREADS=4
YFINANCE_TICKER_DELAY=0.0

# --- Screener.in (India only) ------------------------------------------------------
# Primary source for REPORTED financials (revenue / operating profit / OPM) on Indian
# tickers; yfinance stays the sole source for analyst inputs (EPS estimates, ratings,
# targets) because Screener publishes none, and is also the fallback when Screener is
# unavailable. Screener has no public API, so this is polite scraping: keep the rate low.
SCREENER_ENABLED=true
# Sustained requests/minute and burst size for the process-wide token bucket. This is an
# aggregate limit shared by all FUNDAMENTALS_THREADS workers, not a per-thread limit.
SCREENER_RATE_PER_MIN=10
SCREENER_BURST=3
# Hard ceiling on Screener page fetches in a single run; once hit, the rest of the run
# transparently falls back to yfinance.
SCREENER_MAX_CALLS_PER_RUN=600
# Circuit breaker: after this many consecutive blocked/failed fetches, stop calling
# Screener for COOLDOWN seconds (doubles on each re-trip) and use yfinance meanwhile.
SCREENER_BREAKER_THRESHOLD=5
SCREENER_BREAKER_COOLDOWN=300
# Skip re-fetching a symbol whose Screener data is newer than this many days and whose
# last earnings date hasn't moved. This is the main reason a nightly run is cheap.
SCREENER_CACHE_DAYS=45
SCREENER_TIMEOUT=20
SCREENER_MAX_RETRIES=3
SCREENER_RETRY_BASE_DELAY=2.0
# Sent as User-Agent. Keep it honest and identifiable.
SCREENER_USER_AGENT=MarketEdge/1.0 (+https://github.com/yeddlapurishivasai/marketedge)

# Daily-bar history window fetched per ticker (yfinance period string).
DAILY_LOOKBACK_PERIOD=1y

# Hard cap on stored history (days). Bars older than this are never staged and are
# pruned on every run, keeping a strict rolling 1-year window.
DAILY_LOOKBACK_DAYS=365

# --- Observability / logging (OpenTelemetry -> NDJSON files) ---
# Log directory override (defaults: Linux /var/log/marketedge, Windows C:\ProgramData\MarketEdge\logs)
# MARKETEDGE_LOG_DIR=
MARKETEDGE_LOG_RETENTION_DAYS=7
# MARKETEDGE_ENVIRONMENT=local
# OTEL_LOG_LEVEL=INFO
