AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
SQL_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=MarketEdge;Trusted_Connection=yes;TrustServerCertificate=yes;
QUEUE_NAME=stage-analysis-jobs
QUEUE_POLL_INTERVAL=10
YFINANCE_BATCH_SIZE=50
YFINANCE_BATCH_DELAY=2.0
YFINANCE_MAX_RETRIES=3

# --- Observability / logging (OpenTelemetry -> NDJSON files) ---
# Log directory override (defaults: Linux /var/log/marketedge, Windows C:\ProgramData\MarketEdge\logs)
# MARKETEDGE_LOG_DIR=
MARKETEDGE_LOG_RETENTION_DAYS=7
# MARKETEDGE_ENVIRONMENT=local
# OTEL_LOG_LEVEL=INFO

# --- Options workspace (publish the [options] dacpac first) ---
MARKETEDGE_OPTIONS_ENABLED=false
# Same API key as API Options:KiteApiKey; never commit real credentials.
# MARKETEDGE_KITE_API_KEY=
# Shared with API Options:TokenEncryptionKey: base64-encoded random 32-byte key.
# MARKETEDGE_OPTIONS_TOKEN_KEY=
# Optional model inputs; basic forecasts and quote-based gross expiry payoffs do not require these.
# Annual continuous rate/yield as fractions, e.g. 0.06 means 6%, not 6.
# MARKETEDGE_OPTIONS_RISK_FREE_RATE=
# MARKETEDGE_OPTIONS_DIVIDEND_YIELD=
# Optional round-trip rupee cost estimate per option leg per lot; missing fees leave net values unavailable.
# MARKETEDGE_OPTIONS_COST_PER_LEG=
MARKETEDGE_OPTIONS_ENTRY_MINUTES_BEFORE_CLOSE=30
MARKETEDGE_OPTIONS_EXIT_MINUTES_BEFORE_CLOSE=15
MARKETEDGE_OPTIONS_RETENTION_DAYS=30
